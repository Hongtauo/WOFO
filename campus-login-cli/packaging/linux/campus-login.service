[Unit]
Description=Campus Network Auto Login
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/default/campus-login
ExecStart=/usr/bin/campus-login daemon
Restart=on-failure
RestartSec=10
DynamicUser=true
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
